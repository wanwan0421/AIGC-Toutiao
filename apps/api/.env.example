NODE_ENV=development
API_PORT=3001
WEB_ORIGIN=http://localhost:3000

DATABASE_URL=postgresql://aicp:aicp@localhost:5432/AIGC-Toutiao?schema=public
REDIS_URL=redis://localhost:6379
AI_JOB_QUEUE_NAME=ai-jobs
AI_JOB_WORKER_CONCURRENCY=2
AI_JOB_ATTEMPTS=3
AI_JOB_BACKOFF_MS=2000
AI_JOB_OUTBOX_POLL_MS=2000
AI_JOB_CANCEL_POLL_MS=1000
AI_JOB_COMMIT_TTL_DAYS=7
AI_JOB_EVENT_RETENTION_DAYS=30
AI_JOB_EVENT_CLEANUP_BATCH_SIZE=1000
AI_JOB_EVENT_CLEANUP_MAX_ROWS=100000
WORKER_HEALTH_PORT=3002
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

ARK_API_KEY=
ARK_MODEL_ID=
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_CHAT_COMPLETIONS_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_RESPONSES_API_URL=https://ark.cn-beijing.volces.com/api/v3/responses
# Responses API only. Enables request-data reporting in the Ark console; keep false for sensitive content.
ARK_FORNAX_TRACE=false
AI_CREATIVE_CHAT_API_STYLE=responses
AI_CREATIVE_CHAT_CACHE_ENABLED=true
AI_SKILL_ROUTER_API_STYLE=responses
AI_SKILL_ROUTER_CACHE_ENABLED=true
AI_CONTENT_PRODUCTION_API_STYLE=responses
AI_CONTENT_PRODUCTION_CACHE_ENABLED=true
AI_CHAT_SESSION_LOCK_TTL_MS=120000
AI_CHAT_SESSION_LOCK_RENEW_MS=30000
AI_CHAT_SESSION_MAX_TURNS=24
AI_CHAT_RESPONSE_EXPIRY_SKEW_MS=60000
AI_CHAT_REBUILD_RECENT_MESSAGES=12
AI_CHAT_REBUILD_MAX_INPUT_TOKENS=16000
AI_CHAT_SUMMARY_TRIGGER_MESSAGES=12
AI_CHAT_SUMMARY_MAX_OUTPUT_TOKENS=800
AI_CONVERSATION_COMPACTION_CACHE_ENABLED=true
ARK_IMAGE_API_KEY=
ARK_IMAGE_MODEL_ID=
ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_SIZE=4704x3520
STRUCTURED_OUTPUT_REPAIR_ATTEMPTS=1

UPLOAD_ROOT=uploads
UPLOAD_PUBLIC_BASE=/api/uploads

# Use console locally. Production always uses real email/SMS delivery.
VERIFICATION_DELIVERY_MODE=console

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_CODE_PARAM_NAME=code
