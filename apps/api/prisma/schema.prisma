generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  accountNo    Int               @unique
  email        String?           @unique
  phone        String?           @unique
  passwordHash String
  nickname     String
  bio          String?
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  promptDefinitions PromptDefinition[]
  promptVersions PromptVersion[]
  assets       Asset[]
  contents     Content[]
  events       UserActionEvent[]
  contentReactions ContentReaction[]
  comments     ContentComment[]
  followers    UserFollow[]      @relation("UserFollowers")
  following    UserFollow[]      @relation("UserFollowing")
  aiConversations AiConversation[]
  aiJobs       AiJob[]
  preferences  UserPreference?
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  defaultPlatform String?
  writingStyles   String[] @default([])
  domains         String[] @default([])
  blockedWords    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Content {
  id           String            @id @default(cuid())
  authorId     String
  title        String
  body         String
  bodyHtml     String?
  bodyJson     Json?
  excerpt      String?
  status       ContentStatus     @default(draft)
  visibility   ContentVisibility @default(public)
  tags         String[]          @default([])
  qualityScore Int               @default(0)
  heatScore    Int               @default(0)
  viewCount    Int               @default(0)
  likeCount    Int               @default(0)
  collectCount Int               @default(0)
  clickCount   Int               @default(0)
  publishedAt  DateTime?
  scheduledAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  audits       AuditRecord[]
  author       User              @relation(fields: [authorId], references: [id])
  assets       ContentAsset[]
  versions     ContentVersion[]
  drafts       Draft[]
  scores       QualityScore[]
  events       UserActionEvent[]
  reactions    ContentReaction[]
  comments     ContentComment[]
  aiConversations AiConversation[]
  aiJobs       AiJob[]
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId, createdAt])
  @@index([followingId, createdAt])
}

model ContentReaction {
  id        String              @id @default(cuid())
  userId    String
  contentId String
  type      ContentReactionType
  createdAt DateTime            @default(now())
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   Content             @relation(fields: [contentId], references: [id], onDelete: Cascade)

  @@unique([userId, contentId, type])
  @@index([contentId, type])
  @@index([userId, type, createdAt])
}

model ContentComment {
  id        String   @id @default(cuid())
  contentId String
  authorId  String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  content   Content  @relation(fields: [contentId], references: [id], onDelete: Cascade)
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([contentId, createdAt])
  @@index([authorId, createdAt])
}

model Draft {
  id         String   @id @default(cuid())
  contentId  String   @unique
  authorId   String
  title      String?
  body       String?
  payload    Json?
  clientHash String?
  savedAt    DateTime @updatedAt
  content    Content  @relation(fields: [contentId], references: [id])
}

model ContentVersion {
  id        String   @id @default(cuid())
  contentId String
  version   Int
  title     String
  body      String
  bodyHtml  String?
  bodyJson  Json?
  snapshot  Json?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id])

  @@unique([contentId, version])
}



model PromptDefinition {
  id              String            @id @default(cuid())
  key             String            @unique
  scene           PromptScene
  displayName     String
  description     String?
  status          String            @default("active")
  usageCount      Int               @default(0)
  creatorId       String?
  activeVersionId String?           @unique
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  creator         User?             @relation(fields: [creatorId], references: [id])
  activeVersion   PromptVersion?    @relation("ActivePromptVersion", fields: [activeVersionId], references: [id])
  versions        PromptVersion[]   @relation("PromptDefinitionVersions")
  testCases       PromptTestCase[]
  evalRuns        PromptEvalRun[]

  @@index([scene, status])
}

model PromptVersion {
  id            String             @id @default(cuid())
  definitionId  String
  version       Int
  template      String
  variables     Json?
  model         String?
  modelOptions  Json?
  outputSchema  Json?
  changeNote    String?
  status        String             @default("draft")
  createdById   String?
  createdAt     DateTime           @default(now())
  definition    PromptDefinition   @relation("PromptDefinitionVersions", fields: [definitionId], references: [id], onDelete: Cascade)
  activeFor     PromptDefinition?  @relation("ActivePromptVersion")
  createdBy     User?              @relation(fields: [createdById], references: [id])
  evalRuns      PromptEvalRun[]

  @@unique([definitionId, version])
  @@index([definitionId, createdAt])
}

model PromptTestCase {
  id            String           @id @default(cuid())
  definitionId  String
  name          String
  input         Json
  expectedOutput Json?
  assertions    Json?
  enabled       Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  definition    PromptDefinition @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  evalResults   PromptEvalResult[]

  @@index([definitionId, enabled])
}

model PromptEvalRun {
  id            String             @id @default(cuid())
  definitionId  String
  versionId     String?
  mode          String             @default("dry_run")
  status        String             @default("succeeded")
  total         Int                @default(0)
  passed        Int                @default(0)
  failed        Int                @default(0)
  startedAt     DateTime           @default(now())
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  definition    PromptDefinition   @relation(fields: [definitionId], references: [id], onDelete: Cascade)
  version       PromptVersion?     @relation(fields: [versionId], references: [id])
  results       PromptEvalResult[]

  @@index([definitionId, createdAt])
}

model PromptEvalResult {
  id             String          @id @default(cuid())
  runId          String
  testCaseId     String?
  status         String
  input          Json
  output         Json?
  renderedPrompt String?
  errorMessage   String?
  latencyMs      Int?
  createdAt      DateTime        @default(now())
  run            PromptEvalRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  testCase       PromptTestCase? @relation(fields: [testCaseId], references: [id], onDelete: SetNull)

  @@index([runId, status])
}

model Asset {
  id          String           @id @default(cuid())
  uploaderId  String
  fileName    String
  mimeType    String
  url         String
  source      String           @default("uploaded")
  metadata    Json?
  auditStatus AssetAuditStatus @default(pending)
  auditReason String?
  riskLevel   String?
  riskTypes   String[]         @default([])
  createdAt   DateTime         @default(now())
  uploader    User             @relation(fields: [uploaderId], references: [id])
  contents    ContentAsset[]
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  contentId String?
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  content   Content?    @relation(fields: [contentId], references: [id])
  messages  AiMessage[]

  @@index([userId, contentId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ContentAsset {
  contentId String
  assetId   String
  sortOrder Int     @default(0)
  asset     Asset   @relation(fields: [assetId], references: [id])
  content   Content @relation(fields: [contentId], references: [id])

  @@id([contentId, assetId])
}

model AuditRecord {
  id          String         @id @default(cuid())
  contentId   String
  passed      Boolean
  riskLevel   AuditRiskLevel
  riskTypes   String[]       @default([])
  reasons     String[]       @default([])
  rawResponse Json?
  createdAt   DateTime       @default(now())
  content     Content        @relation(fields: [contentId], references: [id])
}

model QualityScore {
  id          String   @id @default(cuid())
  contentId   String
  total       Int
  dimensions  Json
  reason      String
  rawResponse Json?
  createdAt   DateTime @default(now())
  content     Content  @relation(fields: [contentId], references: [id])
}

model AiCallLog {
  id           String   @id @default(cuid())
  scene        String
  model        String?
  promptKey    String?
  promptVersionId String?
  inputSummary String?
  output       Json?
  latencyMs    Int?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())
}

model AiJob {
  id           String      @id @default(cuid())
  userId       String
  contentId    String?
  type         AiJobType
  status       AiJobStatus @default(queued)
  progress     Int         @default(0)
  currentStep  String?
  input        Json
  result       Json?
  errorMessage String?
  warnings     String[]    @default([])
  attempts     Int         @default(0)
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  user         User        @relation(fields: [userId], references: [id])
  content      Content?    @relation(fields: [contentId], references: [id])

  @@index([userId, createdAt])
  @@index([contentId, createdAt])
  @@index([status, updatedAt])
}

model UserActionEvent {
  id        String   @id @default(cuid())
  userId    String?
  contentId String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([contentId, eventType, createdAt])
}

enum ContentStatus {
  draft
  pending_review
  approved
  rejected
  scheduled
  published
  updated
  offline
}

enum ContentVisibility {
  public
  followers
  private
}

enum PromptScene {
  generate
  audit
  score
  rewrite
}

enum AuditRiskLevel {
  low
  medium
  high
}

enum AssetAuditStatus {
  pending
  approved
  rejected
}

enum ContentReactionType {
  like
  collect
}

enum AiMessageRole {
  user
  assistant
}

enum AiJobStatus {
  queued
  running
  succeeded
  failed
  cancelled
}

enum AiJobType {
  creative_direct_generate
  creative_image_generate
  content_submit_review
  content_approve
  moderation_content_run
  compliance_rewrite
}
