generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String            @id @default(cuid())
  email        String?           @unique
  phone        String?           @unique
  passwordHash String
  nickname     String
  avatarUrl    String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  assets       Asset[]
  contents     Content[]
  prompts      PromptTemplate[]
  events       UserActionEvent[]
  aiConversations AiConversation[]
  preferences  UserPreference?
}

model UserPreference {
  id              String   @id @default(cuid())
  userId          String   @unique
  defaultPlatform String?
  writingStyles   String[] @default([])
  domains         String[] @default([])
  blockedWords    String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id])
}

model Content {
  id           String            @id @default(cuid())
  authorId     String
  title        String
  body         String
  excerpt      String?
  status       ContentStatus     @default(draft)
  tags         String[]          @default([])
  qualityScore Int               @default(0)
  heatScore    Int               @default(0)
  viewCount    Int               @default(0)
  likeCount    Int               @default(0)
  collectCount Int               @default(0)
  clickCount   Int               @default(0)
  publishedAt  DateTime?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  audits       AuditRecord[]
  author       User              @relation(fields: [authorId], references: [id])
  assets       ContentAsset[]
  versions     ContentVersion[]
  drafts       Draft[]
  scores       QualityScore[]
  events       UserActionEvent[]
  aiConversations AiConversation[]
}

model Draft {
  id         String   @id @default(cuid())
  contentId  String   @unique
  authorId   String
  title      String?
  body       String?
  payload    Json?
  clientHash String?
  savedAt    DateTime @updatedAt
  content    Content  @relation(fields: [contentId], references: [id])
}

model ContentVersion {
  id        String   @id @default(cuid())
  contentId String
  version   Int
  title     String
  body      String
  snapshot  Json?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id])

  @@unique([contentId, version])
}

model PromptTemplate {
  id           String      @id @default(cuid())
  creatorId    String?
  name         String
  scene        PromptScene
  template     String
  variables    Json?
  model        String?
  modelOptions Json?
  version      Int         @default(1)
  status       String      @default("active")
  usageCount   Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  creator      User?       @relation(fields: [creatorId], references: [id])
}

model Asset {
  id          String           @id @default(cuid())
  uploaderId  String
  fileName    String
  mimeType    String
  url         String
  source      String           @default("uploaded")
  metadata    Json?
  auditStatus AssetAuditStatus @default(pending)
  auditReason String?
  createdAt   DateTime         @default(now())
  uploader    User             @relation(fields: [uploaderId], references: [id])
  contents    ContentAsset[]
}

model AiConversation {
  id        String      @id @default(cuid())
  userId    String
  contentId String?
  title     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id])
  content   Content?    @relation(fields: [contentId], references: [id])
  messages  AiMessage[]

  @@index([userId, contentId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversationId String
  role           AiMessageRole
  content        String
  metadata       Json?
  createdAt      DateTime       @default(now())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

model ContentAsset {
  contentId String
  assetId   String
  sortOrder Int     @default(0)
  asset     Asset   @relation(fields: [assetId], references: [id])
  content   Content @relation(fields: [contentId], references: [id])

  @@id([contentId, assetId])
}

model AuditRecord {
  id          String         @id @default(cuid())
  contentId   String
  passed      Boolean
  riskLevel   AuditRiskLevel
  riskTypes   String[]       @default([])
  reasons     String[]       @default([])
  rawResponse Json?
  createdAt   DateTime       @default(now())
  content     Content        @relation(fields: [contentId], references: [id])
}

model QualityScore {
  id          String   @id @default(cuid())
  contentId   String
  total       Int
  dimensions  Json
  reason      String
  rawResponse Json?
  createdAt   DateTime @default(now())
  content     Content  @relation(fields: [contentId], references: [id])
}

model AiCallLog {
  id           String   @id @default(cuid())
  scene        String
  model        String?
  inputSummary String?
  output       Json?
  latencyMs    Int?
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())
}

model UserActionEvent {
  id        String   @id @default(cuid())
  userId    String?
  contentId String
  eventType String
  metadata  Json?
  createdAt DateTime @default(now())
  content   Content  @relation(fields: [contentId], references: [id])
  user      User?    @relation(fields: [userId], references: [id])

  @@index([contentId, eventType, createdAt])
}

enum ContentStatus {
  draft
  pending_review
  approved
  rejected
  published
  updated
  offline
}

enum PromptScene {
  generate
  audit
  score
  rewrite
}

enum AuditRiskLevel {
  low
  medium
  high
}

enum AssetAuditStatus {
  pending
  approved
  rejected
}

enum AiMessageRole {
  user
  assistant
}
