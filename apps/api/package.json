{
  "name": "@aicp/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "prisma generate --schema ./prisma/schema.prisma && nest start",
    "start:dev": "nest start --watch",
    "start:worker": "node dist/worker.js",
    "start:worker:dev": "ts-node -r tsconfig-paths/register src/worker.ts",
    "build": "nest build",
    "lint": "eslint \"src/**/*.ts\"",
    "eval:high-risk": "node scripts/evaluate-high-risk-accuracy.cjs",
    "migrate:ai-images": "ts-node -r tsconfig-paths/register src/scripts/migrate-ai-image-assets.ts",
    "seed:prompts": "ts-node -r tsconfig-paths/register src/scripts/seed-production-prompts.ts",
    "seed:prompt-eval:safety": "node scripts/seed-safety-review-eval-cases.cjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "smoke:ai-jobs": "ts-node -r tsconfig-paths/register src/scripts/smoke-ai-job-queue.ts",
    "prisma": "prisma"
  },
  "dependencies": {
    "@aicp/shared": "*",
    "@nestjs/common": "^10.3.0",
    "@nestjs/config": "^3.2.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/platform-express": "^10.3.0",
    "@prisma/client": "^5.13.0",
    "bcrypt": "^5.1.1",
    "bullmq": "5.80.9",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "file-type": "^22.0.1",
    "ioredis": "^5.4.0",
    "nodemailer": "^8.0.10",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "prisma": {
    "seed": "node prisma/seed.cjs"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.3.0",
    "@nestjs/schematics": "^10.1.0",
    "@nestjs/testing": "^10.3.0",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.12.0",
    "@types/nodemailer": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^7.7.0",
    "@typescript-eslint/parser": "^7.7.0",
    "eslint": "^8.57.0",
    "prisma": "^5.13.0",
    "source-map-support": "^0.5.21",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.4.0",
    "vitest": "^3.2.4"
  }
}
