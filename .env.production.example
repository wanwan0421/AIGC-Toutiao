# Copy this file to .env.production on the server and fill the real secrets.

NODE_ENV=production

# Production authentication requires HTTPS. Terminate TLS at the load balancer or reverse proxy.
WEB_ORIGIN=https://your-domain.com
AUTH_COOKIE_SECURE=true
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret

POSTGRES_USER=aicp
POSTGRES_PASSWORD=replace-with-a-strong-db-password
POSTGRES_DB=aicp
DATABASE_URL=postgresql://aicp:replace-with-a-strong-db-password@postgres:5432/aicp?schema=public

REDIS_URL=redis://redis:6379

ARK_API_KEY=
ARK_MODEL_ID=
ARK_API_URL=https://ark.cn-beijing.volces.com/api/v3/chat/completions
ARK_IMAGE_API_KEY=
ARK_IMAGE_MODEL_ID=
ARK_IMAGE_API_URL=https://ark.cn-beijing.volces.com/api/v3/images/generations
ARK_IMAGE_SIZE=4704x3520

AMAP_API_KEY=

UPLOAD_ROOT=/app/uploads
UPLOAD_PUBLIC_BASE=https://your-domain.com/api/uploads

# Local/temporary only. For real production delivery, remove this or set real mode.
VERIFICATION_DELIVERY_MODE=real

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
ALIYUN_SMS_REGION_ID=cn-hangzhou
ALIYUN_SMS_ENDPOINT=https://dysmsapi.aliyuncs.com/
ALIYUN_SMS_CODE_PARAM_NAME=code
